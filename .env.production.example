APP_NAME="ระบบจัดการห้องสมุด"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://library.example.com

APP_LOCALE=th
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Bangkok

LOG_CHANNEL=stack
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=library
DB_USERNAME=library
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true

FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database
LIBRARY_LOW_STOCK_THRESHOLD=2
LIBRARY_BACKUP_RETENTION_DAYS=14

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=library@example.com
MAIL_FROM_NAME="${APP_NAME}"
